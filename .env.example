# Copy to .env for local development, or to .env.production for a server.
# Never commit the copy. Every value below is a placeholder.

# --- MySQL -------------------------------------------------------------
MYSQL_DATABASE=dhruvsetu
MYSQL_USER=dhruvsetu_app
MYSQL_PASSWORD=change-me-app-password
MYSQL_ROOT_PASSWORD=change-me-root-password
# Local development: where the API finds MySQL on this computer.
# compose.production.yaml ignores these two and uses its own MySQL container.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307

# --- Website and login --------------------------------------------------
# The address people open. Comma-separated if there is more than one.
# Production: the public HTTPS address, for example https://dhruvsetu.example.org
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production: true (the site must then be served over HTTPS).
AUTH_COOKIE_SECURE=false
SESSION_EXPIRE_MINUTES=480
# Production only: the port of the website on the Docker host.
FRONTEND_PORT=3000

# --- Assistant (OpenRouter) ----------------------------------------------
# Without a key the assistant answers "not configured". Everything else works.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Polar Data Lab -------------------------------------------------------
# Needs Docker on the machine that runs the API. Keep false in production.
DATA_LAB_ENABLED=false

# --- First accounts (python -m app.auth.seed_accounts) --------------------
# Local development only. On a server, give these to the command itself
# (see DEPLOYMENT.md) and do not store them.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_RESEARCHER_EMAIL=
SEED_RESEARCHER_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
